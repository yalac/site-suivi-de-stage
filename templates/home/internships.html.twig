{% extends 'base.html.twig' %}

{% block title %}Stages en cours{% endblock %}

{% block body %}
    <main style="min-height: 100vh; margin: 0; font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, 'Manrope', sans-serif; background: radial-gradient(circle at 18% -5%, rgba(60, 100, 196, 0.32), transparent 38%), radial-gradient(circle at 88% 8%, rgba(40, 141, 211, 0.24), transparent 32%), linear-gradient(165deg, #0b1b3f 0%, #081433 46%, #07112a 100%); color: #f2f7ff; padding: 2rem 1.5rem;">
        <section style="max-width: 1200px; margin: 0 auto;">
            <header style="margin-bottom: 1.2rem;">
                <h1 style="margin: 0 0 0.4rem; font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 700;">Stages en cours</h1>
                <p style="margin: 0; color: #9cafcb; font-size: 0.98rem;">Liste des stages actifs et actions rapides.</p>
            </header>

            <div style="border-radius: 14px; padding: 1rem; background: rgba(8, 20, 47, 0.9); border: 1px solid rgba(104, 137, 197, 0.12); box-shadow: 0 8px 24px rgba(3,10,24,0.5);">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.8rem; gap:1rem; flex-wrap:wrap;">
                    <div style="color:#9cafcb; font-size:0.95rem;">Afficher les stages en cours (date du jour utilisée pour filtrer).</div>
                    <div>
                        <a href="{{ path('app_stage_new') }}" style="background:#2b69c9; color:#fff; padding:0.45rem 0.8rem; border-radius:8px; text-decoration:none;">Créer un stage</a>
                    </div>
                </div>

                {% if stages is empty %}
                    <p style="color:#9cafcb;">Aucun stage en cours.</p>
                    <div style="margin-top:0.8rem; color:#9cafcb;">
                        <p>Diagnostic : <strong>{{ allStages|length }}</strong> stage(s) en base.</p>
                        {% if allStages is not empty %}
                            <details style="color:#cfe3ff;">
                                <summary style="cursor:pointer;">Voir tous les stages (debug)</summary>
                                <table style="width:100%; border-collapse:collapse; margin-top:0.6rem;">
                                    <thead>
                                        <tr style="text-align:left; color:#cfe3ff;">
                                            <th style="padding:0.4rem; border-bottom:1px solid rgba(255,255,255,0.04);">ID</th>
                                            <th style="padding:0.4rem; border-bottom:1px solid rgba(255,255,255,0.04);">Élève</th>
                                            <th style="padding:0.4rem; border-bottom:1px solid rgba(255,255,255,0.04);">Entreprise</th>
                                            <th style="padding:0.4rem; border-bottom:1px solid rgba(255,255,255,0.04);">Date début</th>
                                            <th style="padding:0.4rem; border-bottom:1px solid rgba(255,255,255,0.04);">Date fin</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    {% for s in allStages %}
                                        <tr>
                                            <td style="padding:0.4rem;">{{ s.id }}</td>
                                            <td style="padding:0.4rem;">{{ s.idEleve ? (s.idEleve.prenom ~ ' ' ~ s.idEleve.nom) : 'NULL' }}</td>
                                            <td style="padding:0.4rem;">{{ s.idEntreprise ? s.idEntreprise.nom : 'NULL' }}</td>
                                            <td style="padding:0.4rem;">{{ s.dateDebut ? s.dateDebut|date('Y-m-d') : 'NULL' }}</td>
                                            <td style="padding:0.4rem;">{{ s.dateFin ? s.dateFin|date('Y-m-d') : 'NULL' }}</td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </details>
                        {% endif %}
                    </div>
                {% else %}
                    <div style="overflow:auto;">
                    <table style="width:100%; border-collapse:collapse;">
                        <thead>
                            <tr style="text-align:left; color:#cfe3ff;">
                                <th style="padding:0.6rem 0.8rem; border-bottom:1px solid rgba(255,255,255,0.04);">ID</th>
                                <th style="padding:0.6rem 0.8rem; border-bottom:1px solid rgba(255,255,255,0.04);">Élève</th>
                                <th style="padding:0.6rem 0.8rem; border-bottom:1px solid rgba(255,255,255,0.04);">Entreprise</th>
                                <th style="padding:0.6rem 0.8rem; border-bottom:1px solid rgba(255,255,255,0.04);">Date début</th>
                                <th style="padding:0.6rem 0.8rem; border-bottom:1px solid rgba(255,255,255,0.04);">Date fin</th>
                                <th style="padding:0.6rem 0.8rem; border-bottom:1px solid rgba(255,255,255,0.04);">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for stage in stages %}
                            <tr style="border-top:1px solid rgba(255,255,255,0.02);">
                                <td style="padding:0.6rem 0.8rem;">{{ stage.id }}</td>
                                <td style="padding:0.6rem 0.8rem;">{{ stage.idEleve.prenom }} {{ stage.idEleve.nom }}</td>
                                <td style="padding:0.6rem 0.8rem;">{{ stage.idEntreprise.nom }}</td>
                                <td style="padding:0.6rem 0.8rem;">{{ stage.dateDebut ? stage.dateDebut|date('Y-m-d') : '—' }}</td>
                                <td style="padding:0.6rem 0.8rem;">{{ stage.dateFin ? stage.dateFin|date('Y-m-d') : '—' }}</td>
                                <td style="padding:0.6rem 0.8rem;">
                                    <a href="{{ path('app_stage_show', {'id': stage.id}) }}" style="color:#9cafcb; text-decoration:none; margin-right:0.6rem;">Voir</a>
                                    <a href="{{ path('app_stage_edit', {'id': stage.id}) }}" style="color:#9cafcb; text-decoration:none; margin-right:0.6rem;">Modifier</a>
                                    <form method="post" action="{{ path('app_stage_delete', {'id': stage.id}) }}" style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stage.id) }}">
                                        <button type="submit" style="background:transparent; color:#ff7b7b; border:0; padding:0; cursor:pointer;" onclick="return confirm('Supprimer ce stage ?');">Supprimer</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    </div>
                {% endif %}
            </div>
        </section>
    </main>

{% endblock %}


