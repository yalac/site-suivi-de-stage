{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block stylesheets %}
    <style>
        .dashboard-grid {
            display: grid;
            gap: 1rem;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="app-page">
        <section class="app-container">
            <header class="app-header">
                <h1 class="app-title">Tableau de bord</h1>
                <p class="app-subtitle">Suivi des stages - BTS SIO La Chataigneraie</p>
            </header>

            <section class="app-card dashboard-grid">
                <p class="app-muted">Utilisez la barre latérale pour accéder rapidement aux utilisateurs, entreprises, stages, suivi et historique.</p>
            </section>
        </section>
    </main>
{% endblock %}
