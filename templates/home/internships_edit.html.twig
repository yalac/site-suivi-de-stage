{% extends 'base.html.twig' %}

{% block title %}Modifier le stage{% endblock %}

{% block body %}
    <main style="min-height: 100vh; margin: 0; font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, 'Manrope', sans-serif; background: radial-gradient(circle at 18% -5%, rgba(60, 100, 196, 0.32), transparent 38%), radial-gradient(circle at 88% 8%, rgba(40, 141, 211, 0.24), transparent 32%), linear-gradient(165deg, #0b1b3f 0%, #081433 46%, #07112a 100%); color: #f2f7ff; padding: 2rem 1.5rem;">
        <section style="max-width: 900px; margin: 0 auto;">
            <header style="margin-bottom:1rem;">
                <h1 style="margin:0 0 0.4rem; font-size:1.6rem; font-weight:700;">Modifier le stage</h1>
                <p style="margin:0; color:#9cafcb;">Mettez à jour les informations du stage.</p>
            </header>

            <div style="border-radius:14px; padding:1rem; background:rgba(8,20,47,0.9); border:1px solid rgba(104,137,197,0.08); box-shadow:0 8px 24px rgba(3,10,24,0.45);">
                {{ form_start(form) }}
                    <div style="margin-bottom:0.8rem;">{{ form_widget(form) }}</div>
                    <div style="display:flex; gap:0.6rem;">
                        <button type="submit" style="background:#2b69c9; color:#fff; padding:0.5rem 0.9rem; border-radius:8px; border:0;">Enregistrer</button>
                        <a href="{{ path('app_internships') }}" style="align-self:center; color:#9cafcb; text-decoration:none;">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </section>
    </main>

{% endblock %}
