{% extends 'base.html.twig' %}

{% block title %}Nouveau stage{% endblock %}

{% block stylesheets %}
    <style>
        .page-header {
            margin-bottom: 1rem;
        }

        .page-header p {
            margin: 0;
        }

        .form-stack {
            display: grid;
            gap: 0.8rem;
        }

        .form-actions {
            display: flex;
            gap: 0.6rem;
            flex-wrap: wrap;
            align-items: center;
        }

        .form-actions .app-button-primary {
            margin: 0;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="app-page">
        <section class="app-container" style="max-width: 900px;">
            <header class="page-header app-header">
                <h1 class="app-title">Créer un stage</h1>
                <p class="app-subtitle">Remplissez le formulaire pour créer un nouveau stage.</p>
            </header>

            <div class="app-card">
                {{ form_start(form) }}
                    <div class="form-stack">{{ form_widget(form) }}</div>
                    <div class="form-actions" style="margin-top: 0.8rem;">
                        <button type="submit" class="app-button-primary">Enregistrer</button>
                        <a href="{{ path('app_internships') }}" class="app-link">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </section>
    </main>

{% endblock %}
