{% extends 'base.html.twig' %}

{% block title %}Historique des stages{% endblock %}

{% block stylesheets %}
    <style>
        .page-header {
            margin-bottom: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
        }

        .page-header-content {
            flex: 1;
        }

        .page-header p {
            margin: 0;
        }

        .page-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 0.8rem;
        }

        .page-actions p {
            margin: 0;
        }

        .table-wrap {
            overflow: auto;
        }

        .table-actions a {
            margin-right: 0.6rem;
        }

        .table-actions form {
            display: inline;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="app-page">
        <section class="app-container">
            <header class="page-header app-header">
                <div class="page-header-content">
                    <h1 class="app-title">Historique des stages</h1>
                    <p class="app-subtitle">Liste des stages terminés et archivés.</p>
                </div>
            </header>

            <section class="app-card">
                <div class="page-actions">
                    <p class="app-muted">Consultation de tous les stages terminés.</p>
                </div>

                {% if stages is empty %}
                    <p class="app-muted">Aucun stage terminé.</p>
                {% else %}
                    <div class="table-wrap">
                    <table class="table-left">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Élève</th>
                                <th>Entreprise</th>
                                <th>Date début</th>
                                <th>Date fin</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for stage in stages %}
                            <tr>
                                <td>{{ stage.id }}</td>
                                <td>{{ stage.elevePrincipalStage ? stage.elevePrincipalStage.prenomEleve ~ ' ' ~ stage.elevePrincipalStage.nomEleve : '—' }}</td>
                                <td>{{ stage.entrepriseStage.nomEntreprise }}</td>
                                <td>{{ stage.dateDebutStage ? stage.dateDebutStage|date('Y-m-d') : '—' }}</td>
                                <td>{{ stage.dateFinStage ? stage.dateFinStage|date('Y-m-d') : '—' }}</td>
                                <td class="table-actions">
                                    <a class="app-link" href="{{ path('app_stage_show', {'id': stage.id}) }}">Voir</a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    </div>
                {% endif %}
            </section>
        </section>
    </main>

{% endblock %}

