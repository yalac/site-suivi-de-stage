{% extends 'base.html.twig' %}

{% block title %}Historique des modifications{% endblock %}

{% block stylesheets %}
    <style>
        .page-header {
            margin-bottom: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
        }

        .page-header-content {
            flex: 1;
        }

        .page-header p {
            margin: 0;
        }

        .page-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 0.8rem;
        }

        .page-actions p {
            margin: 0;
        }

        .table-wrap {
            overflow: auto;
        }

        .table-actions a {
            margin-right: 0.6rem;
        }

        .table-actions form {
            display: inline;
        }

        .history-type-badge {
            display: inline-block;
            padding: 0.25rem 0.6rem;
            border-radius: 3px;
            font-size: 0.85rem;
            font-weight: bold;
            white-space: nowrap;
        }

        .history-type-created {
            background-color: #d4edda;
            color: #155724;
        }

        .history-type-modified {
            background-color: #fff3cd;
            color: #856404;
        }

        .history-type-deleted {
            background-color: #f8d7da;
            color: #721c24;
        }

        .history-change {
            font-size: 0.9rem;
            color: #666;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="app-page">
        <section class="app-container">
            <header class="page-header app-header">
                <div class="page-header-content">
                    <h1 class="app-title">Historique des modifications</h1>
                    <p class="app-subtitle">Suivi complet de toutes les modifications apportées aux stages, élèves, utilisateurs et entreprises.</p>
                </div>
            </header>

            <section class="app-card">
                <div class="page-actions">
                    <p class="app-muted">Affichage des {{ historiques|length }} modifications enregistrées.</p>
                    <form method="post" action="{{ path('app_history_clear') }}" onsubmit="return confirm('Supprimer tout l\'historique ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('clear_history') }}">
                        <button type="submit" class="app-button-danger">Tout supprimer</button>
                    </form>
                </div>

                {% if historiques is empty %}
                    <p class="app-muted">Aucune modification enregistrée.</p>
                {% else %}
                    <div class="table-wrap">
                    <table class="table-left">
                        <thead>
                            <tr>
                                <th width="15%" style="font-weight: bold; font-size: 20px;">Date</th>
                                <th width="12%" style="font-weight: bold; font-size: 20px;">Type</th>
                                <th width="15%" style="font-weight: bold; font-size: 20px;">Qui</th>
                                <th width="18%" style="font-weight: bold; font-size: 20px;">Changement</th>
                                <th width="5%" style="font-weight: bold; font-size: 20px;">Supprimer</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for historique in historiques %}
                            <tr>
                                <td>{{ historique.dateModification|date('d/m/Y H:i:s') }}</td>
                                <td>
                                    <span class="history-type-badge history-type-{{ historique.typeAction|lower }}">
                                        {{ historique.typeAction }}
                                    </span>
                                </td>
                                <td>{{ historique.actorLabel }}</td>
                                <td class="history-change">
                                    {% if historique.typeAction == 'modifié' %}
                                        <strong>{{ historique.champModifie }}:</strong> {{ historique.ancienneValeur ?: '∅' }} → {{ historique.nouvelleValeur ?: '∅' }}
                                    {% elseif historique.typeAction == 'créé' %}
                                        <strong>Création:</strong> ∅ → {{ historique.nouvelleValeur ?: '∅' }}
                                    {% elseif historique.typeAction == 'supprimé' %}
                                        <strong>Suppression:</strong> {{ historique.ancienneValeur ?: '∅' }} → ∅
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td class="table-actions">
                                    {{ include('_partials/delete_form.html.twig', {
                                        route_name: 'app_history_delete',
                                        route_params: {'id': historique.id},
                                        csrf_token_id: 'delete_history_' ~ historique.id,
                                        confirm_message: 'Supprimer cette entrée d\'historique ?',
                                    }) }}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    </div>
                {% endif %}
            </section>
        </section>
    </main>

{% endblock %}

