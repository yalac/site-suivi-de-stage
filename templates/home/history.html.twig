{% extends 'base.html.twig' %}

{% block title %}Historique des stages{% endblock %}

{% block stylesheets %}
    <style>
        .page-header {
            margin-bottom: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
        }

        .page-header-content {
            flex: 1;
        }

        .page-header p {
            margin: 0;
        }

        .page-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 0.8rem;
        }

        .page-actions p {
            margin: 0;
        }

        .table-wrap {
            overflow: auto;
        }

        .table-actions a {
            margin-right: 0.6rem;
        }

        .table-actions form {
            display: inline;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="app-page">
        <section class="app-container">
            <header class="page-header app-header">
                <div class="page-header-content">
                    <h1 class="app-title">Historique des stages</h1>
                    <p class="app-subtitle">Liste des stages terminés et archivés.</p>
                </div>
            </header>

            <section class="app-card">
                <div class="page-actions">
                    <p class="app-muted">Consultation de tous les stages terminés.</p>
                </div>

                {% if stages is empty %}
                    <p class="app-muted">Aucun stage terminé.</p>
                {% else %}
                    <div class="table-wrap">
                    <table class="table-left">
                        <thead>
                            <tr>
                                <th width="10%" style="font-weight: bold; font-size: 20px;">Étudiant</th>
                                <th width="10%" style="font-weight: bold; font-size: 20px;">Professeur référent</th>
                                <th width="10%" style="font-weight: bold; font-size: 20px;">Professeur visite</th>
                                <th width="10%" style="font-weight: bold; font-size: 20px;">Entreprise</th>
                                <th width="15%" style="font-weight: bold; font-size: 20px;">Remarque</th>
                                <th width="10%" style="font-weight: bold; font-size: 20px;">Date</th>
                                <th width="10%" style="font-weight: bold; font-size: 20px;">Durée en jours</th>
                                <th width="25%" style="font-weight: bold; font-size: 20px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for stage in stages %}
                            <tr>
                                <td>{{ stage.eleveStage ? stage.eleveStage.prenomEleve ~ ' ' ~ stage.eleveStage.nomEleve : '-' }}</td>
                                <td>{{ stage.profReferent ?: '-' }}</td>
                                <td>{{ stage.profVisite ?: '-' }}</td>
                                <td>{{ stage.entrepriseStage.nomEntreprise }}</td>
                                <td>{{ stage.descriptifStage }}</td>
                                <td>{{ stage.dateDebutStage ? stage.dateDebutStage|date('d/m/Y') : '—' }}<br />{{ stage.dateFinStage ? stage.dateFinStage|date('d/m/Y') : '—' }}</td>
                                <td>{{ stage.dateFinStage and stage.dateDebutStage ? ((stage.dateFinStage|date('U')) - (stage.dateDebutStage|date('U'))) / 86400 : '—' }}</td>
                                <td class="table-actions">
                                    <a class="app-link" href="{{ path('app_stage_show', {'id': stage.id}) }}">Voir</a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    </div>
                {% endif %}
            </section>
        </section>
    </main>

{% endblock %}

