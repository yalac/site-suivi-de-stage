{% extends 'base.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block stylesheets %}
    <style>
        .page-header {
            margin-bottom: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
        }

        .page-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 0.8rem;
        }

        .page-actions .app-button-primary {
            white-space: nowrap;
        }

            .page-actions p {
                margin: 0;
            }

            .table-wrap {
                overflow: auto;
            }
        .actions a {
            margin: 0 0.4rem;
        }

        .empty {
            padding: 1rem;
            text-align: center;
        }

        .table-actions {
            white-space: nowrap;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="app-page">
        <section class="app-container">
            <header class="page-header app-header">
                <div class="page-header-content">
                    <h1 class="app-title">Utilisateurs</h1>
                    <p class="app-subtitle">Liste des élèves et gestion des comptes.</p>
                </div>

                <div class="page-actions">
                    <a class="app-button-primary" href="{{ path('app_eleve_new') }}">Créer un nouvel élève</a>
                    <a class="app-button-primary" href="{{ path('app_utilisateur_new') }}">Créer un nouvel utilisateur</a>
                </div>
            </header>

            <section class="app-card">
                <div class="page-actions">
                    <p class="app-muted">Liste des élèves ({{ eleves|length }})</p>
                </div>

                    <div class="table-wrap">
                        <table class="table-left">
                            <thead>
                                <tr>
                                    <th width="20%" style="font-weight: bold; font-size: 20px;">Nom</th>
                                    <th width="20%" style="font-weight: bold; font-size: 20px;">Prénom</th>
                                    <th width="20%" style="font-weight: bold; font-size: 20px;">Option</th>
                                    <th width="20%" style="font-weight: bold; font-size: 20px;">Promotion</th>
                                    <th width="20%" style="font-weight: bold; font-size: 20px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for eleve in eleves %}
                                <tr>
                                    <td>{{ eleve.nomEleve }}</td>
                                    <td>{{ eleve.prenomEleve }}</td>
                                    <td>{{ eleve.optionEleve.nomOption }}</td>
                                    <td>{{ eleve.promotionEleve.classePromotion }} - {{ eleve.promotionEleve.anneePromotion }}</td>
                                    <td class="actions">
                                        <a class="app-link" href="{{ path('app_eleve_edit', {'id': eleve.id}) }}">Modifier</a>
                                        {{ include('eleve/_delete_form.html.twig') }}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="empty app-muted">Aucun élève trouvé</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>
                <br />
                <br />
                <section class="app-card">
                    <div class="page-actions">
                        <p class="app-muted">Liste des professeurs et administrateurs ({{ utilisateurs|length }})</p>
                    </div>

                    <div class="table-wrap">
                        <table class="table-left">
                           <thead>
                                <tr>
                                    <th width="20%" style="font-weight: bold; font-size: 20px;">Nom</th>
                                    <th width="20%" style="font-weight: bold; font-size: 20px;">Prénom</th>
                                    <th width="20%" style="font-weight: bold; font-size: 20px;">Email</th>
                                    <th width="20%" style="font-weight: bold; font-size: 20px;">Rôle</th>
                                    <th width="20%" style="font-weight: bold; font-size: 20px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for utilisateur in utilisateurs %}
                                <tr>
                                    <td>{{ utilisateur.nomUtilisateur }}</td>
                                    <td>{{ utilisateur.prenomUtilisateur }}</td>
                                    <td>{{ utilisateur.emailUtilisateur }}</td>
                                    <td>{{ utilisateur.roleUtilisateur.nomRole|lower }}</td>
                                    <td class="actions">
                                        <a class="app-link" href="{{ path('app_utilisateur_edit', {'id': utilisateur.id}) }}">Modifier</a>
                                        {{ include('utilisateur/_delete_form.html.twig') }}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="5" class="empty app-muted">Aucun utilisateur trouvé</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
            </section>
        </section>
    </main>
{% endblock %}
