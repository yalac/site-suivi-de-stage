{% extends 'base.html.twig' %}

{% block title %}Entreprises{% endblock %}

{% block stylesheets %}
    <style>
        .page-header {
            margin-bottom: 1.2rem;
        }

        .page-header p {
            margin: 0;
        }

        .page-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 0.8rem;
        }

        .page-actions p {
            margin: 0;
        }

        .table-wrap {
            overflow: auto;
        }

        .table-left {
            width: 100%;
            border-collapse: collapse;
        }

        .table-left th {
            text-align: left;
        }

        .table-left td,
        .table-left th {
            padding: 0.6rem 0.8rem;
        }

        .table-left thead th {
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        }

        .table-left tbody tr {
            border-top: 1px solid rgba(255, 255, 255, 0.02);
        }

        .table-actions a {
            margin-right: 0.6rem;
        }

        .table-actions form {
            display: inline;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="app-page">
        <section class="app-container">
            <header class="page-header app-header">
                <h1 class="app-title">Entreprises</h1>
                <p class="app-subtitle">Liste des entreprises enregistrées et actions rapides.</p>
            </header>

            <div class="app-card">
                <div class="page-actions">
                    <p class="app-muted">Afficher toutes les entreprises enregistrées dans la base.</p>
                    <a href="{{ path('app_entreprise_new') }}" class="app-button-primary">Créer une entreprise</a>
                </div>

                {% if entreprises is empty %}
                    <p class="app-muted">Aucune entreprise enregistrée.</p>
                {% else %}
                    <div class="table-wrap">
                    <table class="table-left">
                        <thead>
                            <tr style="text-align:left; color:#cfe3ff;">
                                <th>ID</th>
                                <th>Nom</th>
                                <th>Adresse</th>
                                <th>Code postal</th>
                                <th>Ville</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for entreprise in entreprises %}
                            <tr>
                                <td>{{ entreprise.id }}</td>
                                <td>{{ entreprise.nomEntreprise }}</td>
                                <td>{{ entreprise.adresseEntreprise }}</td>
                                <td>{{ entreprise.cpentreprise }}</td>
                                <td>{{ entreprise.villeEntreprise }}</td>
                                <td class="table-actions">
                                    <a class="app-link" href="{{ path('app_entreprise_show', {'id': entreprise.id}) }}">Voir</a>
                                    <a class="app-link" href="{{ path('app_entreprise_edit', {'id': entreprise.id}) }}">Modifier</a>
                                    <form method="post" action="{{ path('app_entreprise_delete', {'id': entreprise.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entreprise.id) }}">
                                        <button type="submit" class="app-button-danger" onclick="return confirm('Voulez-vous vraiment supprimer cette entreprise ?');">Supprimer</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    </div>
                {% endif %}
            </div>
        </section>
    </main>

{% endblock %}


