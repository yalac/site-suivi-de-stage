{% extends 'base.html.twig' %}

{% block title %}Entreprises{% endblock %}

{% block stylesheets %}
    <style>
        .page-header {
            margin-bottom: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 1rem;
        }

        .page-header-content {
            flex: 1;
        }

        .page-header p {
            margin: 0;
        }

        .page-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 0.8rem;
        }

        .page-actions p {
            margin: 0;
        }

        .table-wrap {
            overflow: auto;
        }

        .table-actions a {
            margin-right: 0.6rem;
        }

        .table-actions form {
            display: inline;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="app-page">
        <section class="app-container">
            <header class="page-header app-header">
                <div class="page-header-content">
                    <h1 class="app-title">Entreprises</h1>
                    <p class="app-subtitle">Liste des entreprises enregistrées</p>
                </div>
                <a href="{{ path('app_entreprise_new') }}" class="app-button-primary">Ajouter une entreprise</a>
            </header>

            <div class="app-card">
                <div class="page-actions">
                    <p class="app-muted">Listes des entreprises ({{ entreprises|length }})</p>
                </div>

                <div class="table-wrap">
                    <table class="table-left">
                        <thead>
                            <tr style="text-align:left; color:#cfe3ff;">
                                <th width="10%" style="font-weight: bold; font-size: 20px;">Nom</th>
                                <th width="10%" style="font-weight: bold; font-size: 20px;">Adresse</th>
                                <th width="10%" style="font-weight: bold; font-size: 20px;">Ville</th>
                                <th width="10%" style="font-weight: bold; font-size: 20px;">Tuteur</th>
                                <th width="10%" style="font-weight: bold; font-size: 20px;">Téléphone</th>
                                <th width="18%" style="font-weight: bold; font-size: 20px;">Mail</th>
                                <th width="20%" style="font-weight: bold; font-size: 20px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for entreprise in entreprises %}
                            <tr>
                                <td>{{ entreprise.nomEntreprise }}</td>
                                <td>{{ entreprise.adresseEntreprise }}</td>
                                <td>{{ entreprise.villeEntreprise }} ({{ entreprise.cpentreprise }})</td>
                                <td>{{ entreprise.tuteurEntreprise }}</td>
                                <td>{{ entreprise.telephoneEntreprise }}</td>
                                <td>{{ entreprise.mailEntreprise }}</td>
                                <td class="table-actions">
                                    <a class="app-link" href="{{ path('app_entreprise_edit', {'id': entreprise.id}) }}">Modifier</a>
                                    <form method="post" action="{{ path('app_entreprise_delete', {'id': entreprise.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entreprise.id) }}">
                                        <button type="submit" class="app-button-danger" onclick="return confirm('Voulez-vous vraiment supprimer cette entreprise ?');">Supprimer</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

{% endblock %}


