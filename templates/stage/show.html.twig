{% extends 'base.html.twig' %}

{% block title %}Stage{% endblock %}

{% block stylesheets %}
    <style>
        .page-header {
            margin-bottom: 1rem;
        }

        .page-header p {
            margin: 0;
        }

        .details-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 1rem;
        }

        .details-table th,
        .details-table td {
            padding: 0.75rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            text-align: left;
            vertical-align: top;
        }

        .details-table th {
            width: 32%;
        }

        .action-row {
            margin-top: 0.25rem;
        }

        .danger-form button {
            padding: 0;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="app-page">
        <section class="app-container">
            <header class="page-header app-header">
                <h1 class="app-title">Détail du stage</h1>
                <p class="app-subtitle">Informations complètes du stage sélectionné.</p>
            </header>

            <section class="app-card">
                <table class="details-table app-table">
                    <tbody>
                        <tr>
                            <th>Étudiant</th>
                            <td>{{ stage.eleveStage ? stage.eleveStage.prenomEleve ~ ' ' ~ stage.eleveStage.nomEleve : 'N/A' }}</td>
                        </tr>
                        <tr>
                            <th>Professeur référent</th>
                            <td>{{ stage.profReferent ?: 'N/A' }}</td>
                        </tr>
                        <tr>
                            <th>Professeur visite</th>
                            <td>{{ stage.profVisite ?: 'N/A' }}</td>
                        </tr>
                        <tr>
                            <th>Entreprise</th>
                            <td>{{ stage.entrepriseStage?.nomEntreprise ?? 'N/A' }}</td>
                        </tr>
                        <tr>
                            <th>Date</th>
                            <td>{{ stage.dateDebutStage ? stage.dateDebutStage|date('d/m/Y') : 'N/A' }} - {{ stage.dateFinStage ? stage.dateFinStage|date('d/m/Y') : 'N/A' }}</td>
                        </tr>
                        <tr>
                            <th>Remarque</th>
                            <td>{{ stage.descriptifStage ?: 'N/A' }}</td>
                        </tr>
                        <tr>
                            <th>Commentaire</th>
                            <td>{{ stage.commentaire ?: 'N/A' }}</td>
                        </tr>
                    </tbody>
                </table>

                <div class="action-row app-section-actions">
                    <a class="app-link" href="{{ path('app_stage') }}">Retour à la liste</a>
                    <div class="danger-form">{{ include('stage/_delete_form.html.twig') }}</div>
                </div>
            </section>
        </section>
    </main>
{% endblock %}
