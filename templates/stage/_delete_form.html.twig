<form method="post" action="{{ path('app_stage_delete', {'id': stage.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce stage ?');" style="display:inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stage.id) }}">
    <button type="submit" style="background:transparent; color:#ff7b7b; border:0; padding:0; cursor:pointer;">Supprimer</button>
</form>
