{{ form_start(form) }}
    <div class="form-stack">
        <div>
            {{ form_label(form.titre, 'Titre', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.titre, {'attr': {'class': 'form-input'}}) }}
            <div class="field-error">{{ form_errors(form.titre) }}</div>
        </div>

        <div>
            {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.description, {'attr': {'class': 'form-input', 'rows': '5'}}) }}
            <div class="field-error">{{ form_errors(form.description) }}</div>
        </div>

        <div>
            {{ form_label(form.idStage, 'Stage', {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.idStage, {'attr': {'class': 'form-input'}}) }}
            <div class="field-error">{{ form_errors(form.idStage) }}</div>
        </div>
    </div>

    <button class="app-button-primary" type="submit">{{ button_label|default('Enregistrer') }}</button>
{{ form_end(form) }}
