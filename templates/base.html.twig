<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <style>
            :root {
                --app-bg-top: #0b1b3f;
                --app-bg-mid: #081433;
                --app-bg-bottom: #07112a;
                --app-surface: rgba(8, 20, 47, 0.9);
                --app-surface-border: rgba(104, 137, 197, 0.12);
                --app-surface-border-strong: rgba(104, 137, 197, 0.5);
                --app-text: #f2f7ff;
                --app-text-soft: #9cafcb;
                --app-text-faint: #cfe3ff;
                --app-primary: #2b69c9;
                --app-primary-hover: #5ca3f0;
                --app-warning: #ffd25c;
                --app-danger: #ff7b7b;
                --app-shadow: 0 8px 24px rgba(3, 10, 24, 0.5);
                --app-radius: 14px;
            }

            html, body {
                min-height: 100%;
                margin: 0;
                padding: 0;
                background: radial-gradient(circle at 18% -5%, rgba(60, 100, 196, 0.32), transparent 38%), radial-gradient(circle at 88% 8%, rgba(40, 141, 211, 0.24), transparent 32%), linear-gradient(165deg, var(--app-bg-top) 0%, var(--app-bg-mid) 46%, var(--app-bg-bottom) 100%);
                color: var(--app-text);
            }

            body {
                min-height: 100vh;
                font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, 'Manrope', sans-serif;
                margin: 0;
                display: flex;
            }

            .app-page {
                min-height: 100vh;
                padding: 2rem 1.5rem;
                box-sizing: border-box;
            }

            .app-container {
                max-width: 1200px;
                margin: 0 auto;
            }

            .app-header {
                margin-bottom: 1rem;
            }

            .app-title {
                margin: 0 0 0.4rem;
                font-size: clamp(1.6rem, 3vw, 2.2rem);
                font-weight: 700;
            }

            .app-card {
                border-radius: var(--app-radius);
                padding: 1rem;
                background: var(--app-surface);
                border: 1px solid var(--app-surface-border);
                box-shadow: var(--app-shadow);
            }

            .app-section-actions {
                display: flex;
                gap: 0.75rem;
                align-items: center;
                flex-wrap: wrap;
            }

            .unified-actions {
                margin-top: 1rem;
            }

            .app-flashes {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                pointer-events: none;
                z-index: 1100;
            }

            .app-flashes.has-modal {
                background: rgba(0, 0, 0, 0.4);
                backdrop-filter: blur(4px);
                pointer-events: auto;
            }

            .app-flash {
                padding: 0.95rem 1.1rem;
                border-radius: 14px;
                border: 1px solid rgba(255, 255, 255, 0.08);
                background: rgba(255, 255, 255, 0.04);
                color: var(--app-text);
                box-shadow: 0 18px 42px rgba(0, 0, 0, 0.36);
                backdrop-filter: blur(8px);
                text-align: center;
                pointer-events: auto;
                display: none;
            }

            .app-flash.app-flash-info,
            .app-flash.app-flash-success {
                display: none;
            }

            .app-modal {
                background: linear-gradient(135deg, rgba(11, 27, 63, 0.98), rgba(7, 17, 42, 0.98));
                border: 1px solid rgba(104, 137, 197, 0.25);
                border-radius: 16px;
                padding: 2rem;
                max-width: 480px;
                width: calc(100vw - 2rem);
                box-shadow: 0 24px 56px rgba(0, 0, 0, 0.5);
                backdrop-filter: blur(8px);
                pointer-events: auto;
                z-index: 1101;
            }

            .app-modal-title {
                font-size: 1.2rem;
                font-weight: 700;
                margin: 0 0 1rem;
                color: var(--app-text);
            }

            .app-modal-message {
                font-size: 0.95rem;
                margin: 0 0 1.5rem;
                color: var(--app-text-soft);
                line-height: 1.5;
            }

            .app-modal-button {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0.65rem 1.5rem;
                border-radius: 8px;
                border: 0;
                cursor: pointer;
                font: inherit;
                font-weight: 600;
                background: var(--app-primary);
                color: #fff;
                transition: background 0.2s ease;
                width: 100%;
            }

            .app-modal-button:hover {
                background: var(--app-primary-hover);
            }

            .app-flash-success {
                border-color: rgba(76, 175, 80, 0.35);
                background: rgba(76, 175, 80, 0.12);
            }

            .app-flash-warning {
                border-color: rgba(255, 210, 92, 0.35);
                background: rgba(255, 210, 92, 0.12);
            }

            .app-flash-error,
            .app-flash-danger {
                border-color: rgba(255, 123, 123, 0.35);
                background: rgba(255, 123, 123, 0.12);
            }

            .app-flash-info {
                border-color: rgba(92, 163, 240, 0.35);
                background: rgba(92, 163, 240, 0.12);
            }

            .app-button,
            .app-button-primary,
            .app-button-secondary,
            .app-button-warning,
            .app-button-danger {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0.5rem 0.9rem;
                border-radius: 8px;
                text-decoration: none;
                border: 0;
                cursor: pointer;
                font: inherit;
            }

            .app-button-primary {
                background: var(--app-primary);
                color: #fff;
            }

            .app-button-secondary {
                background: transparent;
                color: var(--app-text-soft);
            }

            .app-button-warning {
                background: transparent;
                color: var(--app-warning);
            }

            .app-button-danger {
                background: transparent;
                color: var(--app-danger);
            }

            .app-table,
            .table-left {
                width: 100%;
                border-collapse: collapse;
                color: inherit;
            }

            .app-table th,
            .app-table td,
            .table-left th,
            .table-left td {
                padding: 0.75rem;
                border-bottom: 1px solid rgba(255, 255, 255, 0.06);
                text-align: left;
            }

            .app-table th,
            .table-left th {
                color: var(--app-text-soft);
                font-weight: 600;
                font-size: 0.95rem;
            }

            .table-left th {
                border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            }

            .table-left tbody tr {
                border-top: 1px solid rgba(255, 255, 255, 0.02);
            }

            .app-muted {
                color: var(--app-text-soft);
            }

            .app-link {
                color: var(--app-text-soft);
                text-decoration: none;
            }

            /* Sidebar layout */
            .app-shell {
                display: flex;
                width: 100%;
                min-height: 100vh;
            }

            aside.app-sidebar {
                width: 260px;
                background: linear-gradient(180deg, rgba(13, 33, 65, 0.95), rgba(3, 13, 32, 0.95));
                border-right: 1px solid rgba(82, 110, 161, 0.06);
                padding: 14px 16px;
                box-sizing: border-box;
                display: flex;
                flex-direction: column;
                gap: 14px;
                position: sticky;
                top: 0;
                height: 100vh;
                overflow: hidden;
            }

            .app-sidebar .logo {
                display: block;
                width: 100%;
                border-radius: 10px;
                overflow: hidden;
                background: rgba(255,255,255,0.03);
                padding: 8px;
            }

            .app-sidebar .nav {
                display: flex;
                flex-direction: column;
                gap: 8px;
                flex: 1 1 auto;
                overflow-y: auto;
                padding-right: 4px;
            }

            .app-sidebar .nav a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 14px;
                border-radius: 10px;
                color: var(--app-text-faint);
                text-decoration: none;
                font-weight: 600;
                transition: background 0.12s ease;
            }

            .app-sidebar .nav a .icon {
                width: 20px;
                height: 20px;
                display: inline-block;
                border-radius: 6px;
                background: rgba(255,255,255,0.06);
                flex: 0 0 20px;
            }

            .app-sidebar .nav a:hover {
                background: rgba(92,163,240,0.12);
            }

            .app-sidebar .nav a.active {
                background: #4da1ff;
                color: #fff;
                box-shadow: 0 8px 18px rgba(46,100,200,0.18);
            }

            .app-sidebar .sidebar-footer {
                margin-top: 0;
                padding-top: 10px;
                border-top: 1px solid rgba(255, 255, 255, 0.06);
            }

            .app-sidebar .logout-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 14px;
                border-radius: 10px;
                color: var(--app-danger);
                text-decoration: none;
                font-weight: 600;
                transition: background 0.12s ease, color 0.12s ease;
            }

            .app-sidebar .logout-link .icon {
                width: 20px;
                height: 20px;
                display: inline-block;
                border-radius: 6px;
                background: rgba(255,255,255,0.06);
                flex: 0 0 20px;
            }

            .app-sidebar .logout-link:hover {
                background: rgba(255, 123, 123, 0.12);
            }

            .app-main {
                flex: 1 1 auto;
                padding: 18px 22px;
                box-sizing: border-box;
                min-height: 100vh;
            }
        </style>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            <script>
                // Initialiser les modals de flash messages (warning/danger)
                document.addEventListener('DOMContentLoaded', function() {
                    const flashes = document.querySelector('.app-flashes');
                    if (!flashes) return;

                    const warningFlashes = document.querySelectorAll('.app-flash[data-type]');
                    if (warningFlashes.length === 0) return;

                    flashes.classList.add('has-modal');

                    warningFlashes.forEach((flashEl) => {
                        const message = flashEl.textContent;
                        const type = flashEl.getAttribute('data-type');
                        const title = type === 'warning' ? 'Attention' : 'Erreur';

                        const modal = document.createElement('div');
                        modal.className = 'app-modal';
                        modal.innerHTML = `
                            <h2 class="app-modal-title">${title}</h2>
                            <p class="app-modal-message">${message}</p>
                            <button class="app-modal-button">OK</button>
                        `;

                        modal.querySelector('.app-modal-button').addEventListener('click', () => {
                            modal.remove();
                            if (document.querySelectorAll('.app-flash[data-type]').length === 0) {
                                flashes.classList.remove('has-modal');
                            }
                        });

                        flashes.appendChild(modal);
                        flashEl.remove();
                    });
                });
            </script>
        {% endblock %}
    </head>
    <body>
        {% set current_route = app.request is defined ? app.request.attributes.get('_route') : null %}
        {% set is_auth_page = current_route in ['app_login'] %}

        {% block flash_messages %}
            {% if app.flashes is defined %}
                <div class="app-flashes">
                    {% for label, messages in app.flashes %}
                        {% if label in ['warning', 'danger', 'error'] %}
                            {% for message in messages %}
                                <div class="app-flash app-flash-{{ label|lower }}" data-type="{{ label|lower }}">{{ message }}</div>
                            {% endfor %}
                        {% else %}
                            {% for message in messages %}
                                <div class="app-flash app-flash-{{ label|lower }}">{{ message }}</div>
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                </div>
            {% endif %}
        {% endblock %}

        {% if is_auth_page %}
            {{ block('flash_messages') }}
            {{ block('body') }}
        {% else %}
            <div class="app-shell">
                <aside class="app-sidebar">
                    <a href="{{ path('app_home') }}" class="logo">
                        <img src="/images/logo-chataigneraie.png" alt="Logo" style="width:100%; display:block;" />
                    </a>

                    <nav class="nav">
                        <a href="{{ path('app_home') }}" class="{{ current_route == 'app_home' ? 'active' : '' }}">
                            <span class="icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path d="M3 13.5L12 5l9 8.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1v-6.5z" fill="currentColor"/>
                                </svg>
                            </span>
                            <span>Tableau de bord</span>
                        </a>
                        <a href="{{ path('app_users') }}" class="{{ current_route starts with 'app_eleve' or current_route == 'app_users' ? 'active' : '' }}">
                            <span class="icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 20a6 6 0 0 1 16 0" fill="currentColor"/>
                                </svg>
                            </span>
                            <span>Utilisateurs</span>
                        </a>
                        <a href="{{ path('app_entreprise_index') }}" class="{{ current_route starts with 'app_entreprise' ? 'active' : '' }}">
                            <span class="icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path d="M3 21h18V7L12 2 3 7v14zM7 10h10v9H7v-9z" fill="currentColor"/>
                                </svg>
                            </span>
                            <span>Entreprises</span>
                        </a>
                        <a href="{{ path('app_stage') }}" class="{{ current_route starts with 'app_stage' or current_route == 'app_stage' ? 'active' : '' }}">
                            <span class="icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path d="M20 6h-4V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2H4v14h16V6zm-10 0V4h4v2h-4z" fill="currentColor"/>
                                </svg>
                            </span>
                            <span>Stages</span>
                        </a>
                        <a href="{{ path('app_suivi_visite') }}" class="{{ current_route == 'app_suivi_visite' ? 'active' : '' }}">
                            <span class="icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path d="M9 11h6v2H9v-2zm0-4h6v2H9V7z" fill="currentColor"/>
                                    <path d="M19 3H5a2 2 0 0 0-2 2v14l4-3h12a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z" fill="currentColor" opacity="0.9"/>
                                </svg>
                            </span>
                            <span>Suivi &amp; Visite</span>
                        </a>
                        <a href="{{ path('app_history') }}" class="{{ current_route == 'app_history' ? 'active' : '' }}">
                            <span class="icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path d="M13 3a9 9 0 1 0 8.97 8H20a7 7 0 1 1-7-7v4l5-5-5-5v4z" fill="currentColor"/>
                                    <path d="M12 8v5l4 2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                                </svg>
                            </span>
                            <span>Historique</span>
                        </a>
                    </nav>

                    <div class="sidebar-footer">
                        <a href="{{ path('app_logout') }}" class="logout-link">
                            <span class="icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path d="M10 17l1.4-1.4L8.8 13H21v-2H8.8l2.6-2.6L10 7l-5 5 5 5z" fill="currentColor"/>
                                    <path d="M4 5h6V3H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h6v-2H4V5z" fill="currentColor" opacity="0.9"/>
                                </svg>
                            </span>
                            <span>Déconnexion</span>
                        </a>
                    </div>
                </aside>

                <div class="app-main">
                    {{ block('flash_messages') }}
                    {{ block('body') }}
                </div>
            </div>
        {% endif %}
    </body>
</html>
