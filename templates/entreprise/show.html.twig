{% extends 'base.html.twig' %}

{% block title %}Détail entreprise{% endblock %}

{% block stylesheets %}
    <style>
        .page-header {
            margin-bottom: 1rem;
        }

        .page-header p {
            margin: 0;
        }

        .details-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 1rem;
        }

        .details-table th,
        .details-table td {
            padding: 0.7rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            vertical-align: top;
        }

        .details-table th {
            width: 35%;
            text-align: left;
        }

        .stage-actions {
            display: flex;
            gap: 0.6rem;
            align-items: center;
            flex-wrap: wrap;
        }

        .stage-actions .app-button-primary {
            margin: 0;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="app-page">
        <section class="app-container" style="max-width: 900px;">
            <header class="page-header app-header">
                <h1 class="app-title">Détail de l'entreprise</h1>
                <p class="app-subtitle">Informations complètes de l'entreprise sélectionnée.</p>
            </header>

            <div class="app-card">
                <div style="overflow:auto; margin-bottom:1rem;">
                    <table class="details-table">
                        <tbody>
                            <tr>
                                <th>ID</th>
                                <td>{{ entreprise.id }}</td>
                            </tr>
                            <tr>
                                <th>Nom</th>
                                <td>{{ entreprise.nomEntreprise }}</td>
                            </tr>
                            <tr>
                                <th>Adresse</th>
                                <td>{{ entreprise.adresseEntreprise }}</td>
                            </tr>
                            <tr>
                                <th>Code postal</th>
                                <td>{{ entreprise.cpentreprise }}</td>
                            </tr>
                            <tr>
                                <th>Ville</th>
                                <td>{{ entreprise.villeEntreprise }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="stage-actions">
                    <a href="{{ path('app_entreprise_index') }}" class="app-link">Retour à la liste</a>
                    <a href="{{ path('app_entreprise_edit', {'id': entreprise.id}) }}" class="app-button-primary">Modifier</a>
                    {{ include('entreprise/_delete_form.html.twig') }}
                </div>
            </div>
        </section>
    </main>
{% endblock %}
