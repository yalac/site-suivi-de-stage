<form method="post" action="{{ path('app_entreprise_delete', {'id': entreprise.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette entreprise ?');" style="display:inline; margin:0;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entreprise.id) }}">
    <button type="submit" class="app-button-danger">Supprimer</button>
</form>
