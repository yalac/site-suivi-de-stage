{% extends 'base.html.twig' %}

{% block title %}Entreprise index{% endblock %}

{% block stylesheets %}
    <style>
        .page-header {
            margin-bottom: 1rem;
        }

        .page-header p {
            margin: 0;
        }

        .page-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 0.8rem;
        }

        .table-wrap {
            overflow: auto;
        }

        .table-left {
            width: 100%;
            border-collapse: collapse;
        }

        .table-left th {
            text-align: left;
        }

        .table-left td,
        .table-left th {
            padding: 0.6rem 0.8rem;
        }

        .table-left thead th {
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        }

        .table-left tbody tr {
            border-top: 1px solid rgba(255, 255, 255, 0.02);
        }

        .table-actions a {
            margin-right: 0.6rem;
        }

        .table-actions form {
            display: inline;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="app-page">
        <section class="app-container">
            <header class="page-header app-header">
                <h1 class="app-title">Entreprises</h1>
                <p class="app-subtitle">Liste des entreprises enregistrées et actions rapides.</p>
            </header>

            <section class="app-card">
                <div class="page-actions">
                    <p class="app-muted">Afficher toutes les entreprises enregistrées dans la base.</p>
                    <a href="{{ path('app_entreprise_new') }}" class="app-button-primary">Créer une entreprise</a>
                </div>

                {% if entreprises is empty %}
                    <p class="app-muted">Aucune entreprise enregistrée.</p>
                {% else %}
                    <div class="table-wrap">
                        <table class="table-left">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nom</th>
                                    <th>Adresse</th>
                                    <th>Code postal</th>
                                    <th>Ville</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for entreprise in entreprises %}
                                <tr>
                                    <td>{{ entreprise.id }}</td>
                                    <td>{{ entreprise.nomEntreprise }}</td>
                                    <td>{{ entreprise.adresseEntreprise }}</td>
                                    <td>{{ entreprise.cpentreprise }}</td>
                                    <td>{{ entreprise.villeEntreprise }}</td>
                                    <td class="table-actions">
                                        <a class="app-link" href="{{ path('app_entreprise_show', {'id': entreprise.id}) }}">Voir</a>
                                        <a class="app-link" href="{{ path('app_entreprise_edit', {'id': entreprise.id}) }}">Modifier</a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="app-muted">Aucune entreprise trouvée.</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>
        </section>
    </main>
{% endblock %}
