{% extends 'base.html.twig' %}

{% block title %}Utilisateur{% endblock %}

{% block stylesheets %}
    <style>
        .page-header {
            margin-bottom: 1rem;
        }

        .page-header p {
            margin: 0;
        }

        .details-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 1rem;
        }

        .details-table th,
        .details-table td {
            padding: 0.75rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            text-align: left;
            vertical-align: top;
        }

        .details-table th {
            width: 32%;
        }

        .action-row {
            margin-top: 0.25rem;
        }

        .danger-form button {
            padding: 0;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="app-page">
        <section class="app-container">
            <header class="page-header app-header">
                <h1 class="app-title">Détail de l'utilisateur</h1>
                <p class="app-subtitle">Informations complètes de l'utilisateur sélectionné.</p>
            </header>

            <section class="app-card">
                <table class="details-table app-table">
                    <tbody>
                        <tr>
                            <th>NomUtilisateur</th>
                            <td>{{ utilisateur.nomUtilisateur }}</td>
                        </tr>
                        <tr>
                            <th>PrenomUtilisateur</th>
                            <td>{{ utilisateur.prenomUtilisateur }}</td>
                        </tr>
                        <tr>
                            <th>EmailUtilisateur</th>
                            <td>{{ utilisateur.emailUtilisateur }}</td>
                        </tr>
                    </tbody>
                </table>

                <div class="action-row app-section-actions">
                    <a class="app-link" href="{{ path('app_users') }}">Retour à la liste</a>
                    <a class="app-button-primary" href="{{ path('app_utilisateur_edit', {'id': utilisateur.id}) }}">Modifier</a>
                    <div class="danger-form">{{ include('utilisateur/_delete_form.html.twig') }}</div>
                </div>
            </section>
        </section>
    </main>
{% endblock %}
