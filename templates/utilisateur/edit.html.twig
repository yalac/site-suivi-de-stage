{% extends 'base.html.twig' %}

{% block title %}Modifier l'utilisateur{% endblock %}

{% block stylesheets %}
    <style>
        .page-header {
            margin-bottom: 1rem;
        }

        .page-header p {
            margin: 0;
        }

        .danger-form button {
            padding: 0;
        }
    </style>
{% endblock %}


{% block body %}
    <main class="app-page">
        <section class="app-container">
            <header class="page-header app-header">
                <h1 class="app-title">Modifier l'utilisateur</h1>
                <p class="app-subtitle">Mettre à jour les informations de l'utilisateur.</p>
            </header>

            <section class="app-card">
                {{ include('utilisateur/_form.html.twig', {'button_label': 'Enregistrer'}) }}
                {{ include('_partials/form_actions.html.twig', {
                    form_id: 'utilisateur-form',
                    submit_label: 'Enregistrer',
                    cancel_route: 'app_users',
                    delete_partial: 'utilisateur/_delete_form.html.twig',
                    delete_context: {'utilisateur': utilisateur},
                }) }}
            </section>
        </section>
    </main>
{% endblock %}